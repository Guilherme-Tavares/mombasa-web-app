<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todas as propriedades cadastradas</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Propriedades</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Propriedades</h5>
                <a href="/propriedades/criar" class="btn btn-primary btn-sm">
                    <i class="mdi mdi-plus mr-1"></i> Nova Propriedade
                </a>
            </div>
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>Produtor</th>
                                <th>Município / UF</th>
                                <th>Área (ha)</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (propriedades.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Nenhuma propriedade cadastrada.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < propriedades.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= propriedades[i].nome %></td>
                                    <td><%= propriedades[i].produtor ? propriedades[i].produtor.nome : '—' %></td>
                                    <td>
                                        <% if (propriedades[i].municipio || propriedades[i].estado) { %>
                                            <%= propriedades[i].municipio || '' %><%= propriedades[i].municipio && propriedades[i].estado ? ' / ' : '' %><%= propriedades[i].estado || '' %>
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                    <td><%= propriedades[i].areaTotalHectares != null ? propriedades[i].areaTotalHectares : '—' %></td>
                                    <td>
                                        <span class="badge badge-<%= propriedades[i].ativa ? 'success' : 'secondary' %>">
                                            <%= propriedades[i].ativa ? 'Ativa' : 'Inativa' %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/propriedades/<%= propriedades[i].id %>/editar" class="text-warning mr-2">
                                            <i class="mdi mdi-pencil"></i>
                                        </a>
                                        <a href="/propriedades/<%= propriedades[i].id %>/excluir" class="text-danger">
                                            <i class="mdi mdi-delete"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
