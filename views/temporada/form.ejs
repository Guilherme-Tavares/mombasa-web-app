<% const temporada = locals.temporada || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; <%= temporada.id ? 'Atualize os dados da temporada' : 'Preencha os dados da nova temporada' %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/temporadas">Temporadas</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)"><%= titulo %></a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <form action="/temporadas/<%= temporada.id ? temporada.id + '/editar' : 'criar' %>" method="POST">

                    <div class="form-group mb-3">
                        <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nome" name="nome"
                            placeholder="Ex.: Temporada das Águas 2026"
                            value="<%= temporada.nome || '' %>" required>
                    </div>

                    <div class="form-group mb-3">
                        <label for="tipo" class="form-label">Tipo <span class="text-danger">*</span></label>
                        <select class="form-control" id="tipo" name="tipo" required>
                            <option value="">Selecione...</option>
                            <option value="aguas" <%= temporada.tipo === 'aguas' ? 'selected' : '' %>>Águas</option>
                            <option value="seca" <%= temporada.tipo === 'seca' ? 'selected' : '' %>>Seca</option>
                            <option value="transicao" <%= temporada.tipo === 'transicao' ? 'selected' : '' %>>Transição</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label for="dataInicio" class="form-label">Data de Início <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="dataInicio" name="dataInicio"
                                value="<%= temporada.dataInicio || '' %>" required>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label for="dataFim" class="form-label">Data de Fim <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="dataFim" name="dataFim"
                                value="<%= temporada.dataFim || '' %>" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">
                            <%= temporada.id ? 'Salvar Alterações' : 'Cadastrar Temporada' %>
                        </button>
                        <a href="/temporadas" class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
