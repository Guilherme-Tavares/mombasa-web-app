<% const tipoLabels = { aguas: 'Águas', seca: 'Seca', transicao: 'Transição' } %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todas as temporadas cadastradas</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Temporadas</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Temporadas</h5>
                <a href="/temporadas/criar" class="btn btn-primary btn-sm">
                    <i class="mdi mdi-plus mr-1"></i> Nova Temporada
                </a>
            </div>
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>Tipo</th>
                                <th>Início</th>
                                <th>Fim</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (temporadas.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Nenhuma temporada cadastrada.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < temporadas.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= temporadas[i].nome %></td>
                                    <td><%= tipoLabels[temporadas[i].tipo] || temporadas[i].tipo %></td>
                                    <td><%= temporadas[i].dataInicio ? temporadas[i].dataInicio.split('-').reverse().join('/') : '—' %></td>
                                    <td><%= temporadas[i].dataFim ? temporadas[i].dataFim.split('-').reverse().join('/') : '—' %></td>
                                    <td>
                                        <a href="/temporadas/<%= temporadas[i].id %>/editar" class="text-warning mr-2">
                                            <i class="mdi mdi-pencil"></i>
                                        </a>
                                        <a href="/temporadas/<%= temporadas[i].id %>/excluir" class="text-danger">
                                            <i class="mdi mdi-delete"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
