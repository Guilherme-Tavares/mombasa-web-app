<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Entrar | Agroware Mombasa</title>
    <link rel="icon" type="image/png" sizes="16x16" href="/images/mombasa-logo.png">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/agroware.css" rel="stylesheet">

    <style>
        body.login-page {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: linear-gradient(135deg, var(--ag-verde-escuro) 0%, var(--ag-verde) 100%);
            font-family: 'Inter', Roboto, system-ui, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 410px;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 18px 48px rgba(45, 90, 39, .28);
            overflow: hidden;
        }

        .login-card__brand {
            text-align: center;
            padding: 34px 32px 10px;
        }

        .login-card__brand img {
            height: 56px;
            width: auto;
            margin-bottom: 14px;
        }

        .login-card__brand h1 {
            font-size: 21px;
            font-weight: 700;
            color: var(--ag-verde-escuro);
            margin: 0;
        }

        .login-card__brand p {
            font-size: 13px;
            color: var(--ag-texto-sec);
            margin: 4px 0 0;
        }

        .login-card__body {
            padding: 18px 32px 34px;
        }

        .login-card__body .form-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--ag-texto);
            margin-bottom: 5px;
        }

        .login-card__body .form-control {
            height: 46px;
            border-radius: 8px;
        }

        .login-card__body .form-control:focus {
            border-color: var(--ag-verde);
            box-shadow: 0 0 0 .2rem rgba(74, 124, 63, .18);
        }

        .btn-entrar {
            width: 100%;
            height: 46px;
            border: 0;
            border-radius: 8px;
            background: var(--ag-verde);
            color: #fff;
            font-weight: 600;
            font-size: 15px;
            transition: background .15s;
        }

        .btn-entrar:hover {
            background: var(--ag-verde-escuro);
        }

        .login-foot {
            text-align: center;
            font-size: 12px;
            color: rgba(255, 255, 255, .85);
            margin-top: 18px;
        }
    </style>
</head>

<body class="login-page">

    <div>
        <div class="login-card">
            <div class="login-card__brand">
                <img src="/images/mombasa-logo.png" alt="Agroware Mombasa">
                <h1>Agroware Mombasa</h1>
                <p>Acesse sua conta para continuar</p>
            </div>

            <div class="login-card__body">

                <% if (locals.erro) { %>
                    <div class="alert alert-danger py-2" role="alert" style="font-size: 13px;">
                        <%= erro %>
                    </div>
                <% } %>

                <form action="/login" method="POST">

                    <div class="form-group mb-3">
                        <label for="email" class="form-label">E-mail</label>
                        <input type="email" class="form-control" id="email" name="email"
                            placeholder="seu@email.com" autocomplete="username"
                            value="<%= locals.email || '' %>" required autofocus>
                    </div>

                    <div class="form-group mb-4">
                        <label for="senha" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="senha" name="senha"
                            placeholder="••••••••" autocomplete="current-password" required>
                    </div>

                    <button type="submit" class="btn-entrar">Entrar</button>

                </form>
            </div>
        </div>

        <p class="login-foot">&copy; 2026 Agroware Mombasa</p>
    </div>

</body>

</html>
