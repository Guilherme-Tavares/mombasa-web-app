<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todos os produtores cadastrados</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Produtores</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Produtores</h5>
                <a href="/produtores/criar" class="btn btn-primary btn-sm">
                    <i class="icon icon-single-04 mr-1"></i> Novo Produtor
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Telefone</th>
                                <th>Cadastrado em</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (produtores.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Nenhum produtor cadastrado.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < produtores.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= produtores[i].nome %></td>
                                    <td><%= produtores[i].email || '—' %></td>
                                    <td><%= produtores[i].telefone || '—' %></td>
                                    <td><%= dateFormat(produtores[i].dataCadastro, {}, 'pt-BR', true) %></td>
                                    <td>
                                        <a href="/produtores/<%= produtores[i].id %>/editar" class="text-warning mr-2">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/produtores/<%= produtores[i].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
