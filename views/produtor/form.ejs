<% const produtor = locals.produtor || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; <%= produtor.id ? 'Atualize os dados do produtor' : 'Preencha os dados do novo produtor' %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/produtores">Produtores</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)"><%= titulo %></a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form action="/produtores/<%= produtor.id ? produtor.id + '/editar' : 'criar' %>" method="POST">

                    <div class="form-group mb-3">
                        <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nome" name="nome"
                            placeholder="Nome completo do produtor"
                            value="<%= produtor.nome || '' %>" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <input type="email" class="form-control" id="email" name="email"
                                placeholder="email@exemplo.com"
                                value="<%= produtor.email || '' %>">
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label for="telefone" class="form-label">Telefone</label>
                            <input type="text" class="form-control" id="telefone" name="telefone"
                                placeholder="(00) 00000-0000"
                                value="<%= produtor.telefone || '' %>">
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label for="senha" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="senha" name="senha"
                            placeholder="<%= produtor.id ? 'Deixe em branco para manter a senha atual' : 'Senha de acesso' %>">
                        <small class="form-text text-muted">Necessária apenas para sincronização em nuvem.</small>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">
                            <%= produtor.id ? 'Salvar Alterações' : 'Cadastrar Produtor' %>
                        </button>
                        <a href="/produtores" class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
