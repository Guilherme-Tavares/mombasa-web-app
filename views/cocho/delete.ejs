<% const cocho = locals.cocho || {} %>
<% const materialLabels = { madeira: 'Madeira', concreto: 'Concreto', plastico: 'Plástico', metal: 'Metal' } %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Confirme a exclusão do cocho</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/cochos">Cochos</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Excluir</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 offset-lg-3">
        <div class="card border-danger">
            <div class="card-header bg-danger p-3">
                <h5 class="card-title text-white mb-0" style="text-transform: none">Excluir Cocho</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    Esta ação excluirá o registro de forma permanente e não poderá ser desfeita.
                </div>

                <p class="mb-4">Tem certeza que deseja excluir o cocho abaixo?</p>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered mb-0">
                        <tbody>
                            <tr>
                                <th width="35%">Identificação</th>
                                <td><%= cocho.identificacao || '—' %></td>
                            </tr>
                            <tr>
                                <th>Divisão</th>
                                <td><%= cocho.divisao ? cocho.divisao.nome : '—' %></td>
                            </tr>
                            <tr>
                                <th>Material</th>
                                <td><%= cocho.tipoMaterial ? materialLabels[cocho.tipoMaterial] || cocho.tipoMaterial : '—' %></td>
                            </tr>
                            <tr>
                                <th>Capacidade (kg)</th>
                                <td><%= cocho.capacidadeKg %></td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td><%= cocho.ativo ? 'Ativo' : 'Inativo' %></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <form action="/cochos/<%= cocho.id %>/excluir" method="POST">
                    <button type="submit" class="btn btn-danger mr-2">Confirmar Exclusão</button>
                    <a href="/cochos" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
