<% const materialLabels = { madeira: 'Madeira', concreto: 'Concreto', plastico: 'Plástico', metal: 'Metal' } %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todos os cochos cadastrados</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Cochos</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Cochos</h5>
                <a href="/cochos/criar" class="btn btn-primary btn-sm">
                    <i class="mdi mdi-plus mr-1"></i> Novo Cocho
                </a>
            </div>
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Identificação</th>
                                <th>Divisão</th>
                                <th>Material</th>
                                <th>Cap. (kg)</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (cochos.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Nenhum cocho cadastrado.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < cochos.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= cochos[i].identificacao || '—' %></td>
                                    <td><%= cochos[i].divisao ? cochos[i].divisao.nome : '—' %></td>
                                    <td><%= cochos[i].tipoMaterial ? materialLabels[cochos[i].tipoMaterial] || cochos[i].tipoMaterial : '—' %></td>
                                    <td><%= cochos[i].capacidadeKg %></td>
                                    <td>
                                        <span class="badge badge-<%= cochos[i].ativo ? 'success' : 'secondary' %>">
                                            <%= cochos[i].ativo ? 'Ativo' : 'Inativo' %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/cochos/<%= cochos[i].id %>/editar" class="text-warning mr-2">
                                            <i class="mdi mdi-pencil"></i>
                                        </a>
                                        <a href="/cochos/<%= cochos[i].id %>/excluir" class="text-danger">
                                            <i class="mdi mdi-delete"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
