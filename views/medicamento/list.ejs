<% const tipoLabels = { antibiotico: 'Antibiótico', antiparasitario: 'Antiparasitário', vitamina: 'Vitamina', vacina: 'Vacina', outro: 'Outro' } %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todos os medicamentos cadastrados</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Medicamentos</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Medicamentos</h5>
                <a href="/medicamentos/criar" class="btn btn-primary btn-sm">
                    <i class="icon icon-pulse-chart mr-1"></i> Novo Medicamento
                </a>
            </div>
            <div class="card-body">

                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome Comercial</th>
                                <th>Princípio Ativo</th>
                                <th>Tipo</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (medicamentos.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Nenhum medicamento cadastrado.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < medicamentos.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= medicamentos[i].nomeComercial %></td>
                                    <td><%= medicamentos[i].principioAtivo || '—' %></td>
                                    <td><%= tipoLabels[medicamentos[i].tipo] || medicamentos[i].tipo %></td>
                                    <td>
                                        <a href="/medicamentos/<%= medicamentos[i].id %>/editar" class="text-warning mr-2">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/medicamentos/<%= medicamentos[i].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
