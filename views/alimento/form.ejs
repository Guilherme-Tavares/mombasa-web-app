<% const alimento = locals.alimento || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; <%= alimento.id ? 'Atualize os dados do alimento' : 'Preencha os dados do novo alimento' %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/alimentos">Alimentos</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)"><%= titulo %></a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <form action="/alimentos/<%= alimento.id ? alimento.id + '/editar' : 'criar' %>" method="POST">

                    <div class="form-group mb-3">
                        <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nome" name="nome"
                            placeholder="Ex.: Sal Branco, Ração Engorda"
                            value="<%= alimento.nome || '' %>" required>
                    </div>

                    <div class="form-group mb-4">
                        <label for="tipo" class="form-label">Tipo <span class="text-danger">*</span></label>
                        <select class="form-control" id="tipo" name="tipo" required>
                            <option value="">Selecione...</option>
                            <option value="racao" <%= alimento.tipo === 'racao' ? 'selected' : '' %>>Ração</option>
                            <option value="sal_mineral" <%= alimento.tipo === 'sal_mineral' ? 'selected' : '' %>>Sal Mineral</option>
                            <option value="silagem" <%= alimento.tipo === 'silagem' ? 'selected' : '' %>>Silagem</option>
                            <option value="farelo" <%= alimento.tipo === 'farelo' ? 'selected' : '' %>>Farelo</option>
                            <option value="suplemento" <%= alimento.tipo === 'suplemento' ? 'selected' : '' %>>Suplemento</option>
                            <option value="outro" <%= alimento.tipo === 'outro' ? 'selected' : '' %>>Outro</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">
                            <%= alimento.id ? 'Salvar Alterações' : 'Cadastrar Alimento' %>
                        </button>
                        <a href="/alimentos" class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
