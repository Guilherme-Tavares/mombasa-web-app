<% const tipoLabels = { racao: 'Ração', sal_mineral: 'Sal Mineral', silagem: 'Silagem', farelo: 'Farelo', suplemento: 'Suplemento', outro: 'Outro' } %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todos os alimentos cadastrados</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Alimentos</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Alimentos</h5>
                <a href="/alimentos/criar" class="btn btn-primary btn-sm">
                    <i class="icon icon-basket mr-1"></i> Novo Alimento
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>Tipo</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (alimentos.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center text-muted">Nenhum alimento cadastrado.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < alimentos.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= alimentos[i].nome %></td>
                                    <td><%= tipoLabels[alimentos[i].tipo] || alimentos[i].tipo %></td>
                                    <td>
                                        <a href="/alimentos/<%= alimentos[i].id %>/editar" class="text-warning mr-2">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/alimentos/<%= alimentos[i].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
