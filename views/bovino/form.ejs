<% const bovino = locals.bovino || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; <%= bovino.id ? 'Atualize os dados do bovino' : 'Preencha os dados do novo bovino' %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/bovinos">Bovinos</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)"><%= titulo %></a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <form action="/bovinos/<%= bovino.id ? bovino.id + '/editar' : 'criar' %>" method="POST">

                    <div class="form-row">
                        <div class="form-group col-md-8 mb-3">
                            <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="nome" name="nome"
                                placeholder="Ex.: Touro Bravo, Vaca Mimosa"
                                value="<%= bovino.nome || '' %>" required>
                        </div>

                        <div class="form-group col-md-4 mb-3">
                            <label for="brinco" class="form-label">Brinco</label>
                            <input type="text" class="form-control" id="brinco" name="brinco"
                                placeholder="Ex.: BR-001"
                                value="<%= bovino.brinco || '' %>">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4 mb-3">
                            <label for="sexo" class="form-label">Sexo <span class="text-danger">*</span></label>
                            <select class="form-control" id="sexo" name="sexo" required>
                                <option value="">Selecione...</option>
                                <option value="m" <%= bovino.sexo === 'm' ? 'selected' : '' %>>Macho</option>
                                <option value="f" <%= bovino.sexo === 'f' ? 'selected' : '' %>>Fêmea</option>
                            </select>
                        </div>

                        <div class="form-group col-md-4 mb-3">
                            <label for="raca" class="form-label">Raça</label>
                            <input type="text" class="form-control" id="raca" name="raca"
                                placeholder="Ex.: Nelore, Angus"
                                value="<%= bovino.raca || '' %>">
                        </div>

                        <div class="form-group col-md-4 mb-3">
                            <label for="origem" class="form-label">Origem</label>
                            <select class="form-control" id="origem" name="origem">
                                <option value="">—</option>
                                <option value="comprado" <%= bovino.origem === 'comprado' ? 'selected' : '' %>>Comprado</option>
                                <option value="doacao" <%= bovino.origem === 'doacao' ? 'selected' : '' %>>Doação</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4 mb-3">
                            <label for="dataNascimento" class="form-label">Data de Nascimento</label>
                            <input type="date" class="form-control" id="dataNascimento" name="dataNascimento"
                                value="<%= bovino.dataNascimento || '' %>">
                        </div>

                        <div class="form-group col-md-4 mb-3">
                            <label for="pesoAtualKg" class="form-label">Peso Atual (kg)</label>
                            <input type="number" class="form-control" id="pesoAtualKg" name="pesoAtualKg"
                                placeholder="0.00" step="0.01" min="0"
                                value="<%= bovino.pesoAtualKg != null ? bovino.pesoAtualKg : '' %>">
                        </div>

                        <div class="form-group col-md-4 mb-3">
                            <label for="dataUltimaPesagem" class="form-label">Última Pesagem</label>
                            <input type="date" class="form-control" id="dataUltimaPesagem" name="dataUltimaPesagem"
                                value="<%= bovino.dataUltimaPesagem || '' %>">
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label for="ativo" class="form-label">Status</label>
                        <select class="form-control" id="ativo" name="ativo">
                            <option value="1" <%= !bovino.id || bovino.ativo ? 'selected' : '' %>>Ativo</option>
                            <option value="0" <%= bovino.id && !bovino.ativo ? 'selected' : '' %>>Inativo</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">
                            <%= bovino.id ? 'Salvar Alterações' : 'Cadastrar Bovino' %>
                        </button>
                        <a href="/bovinos" class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
