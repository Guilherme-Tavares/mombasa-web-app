<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Registre aplicações de medicamentos em bovinos</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Aplicações</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Aplicações</h5>
                <a href="/aplicacoes/criar" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus mr-1"></i> Nova Aplicação
                </a>
            </div>
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Bovino</th>
                                <th>Medicamento</th>
                                <th>Dose</th>
                                <th>Data de Aplicação</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (aplicacoes.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Nenhuma aplicação cadastrada.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < aplicacoes.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= aplicacoes[i].bovino ? aplicacoes[i].bovino.nome : '—' %></td>
                                    <td><%= aplicacoes[i].medicamento ? aplicacoes[i].medicamento.nomeComercial : '—' %></td>
                                    <td><%= aplicacoes[i].dose != null ? parseFloat(aplicacoes[i].dose).toFixed(2) + ' ' + aplicacoes[i].unidadeDose : '—' %></td>
                                    <td><%= aplicacoes[i].dataAplicacao ? new Date(aplicacoes[i].dataAplicacao).toLocaleString('pt-BR') : '—' %></td>
                                    <td>
                                        <a href="/aplicacoes/<%= aplicacoes[i].id %>/editar" class="text-warning mr-2">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/aplicacoes/<%= aplicacoes[i].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
