<% const finalidadeLabels = { recria: 'Recria', engorda: 'Engorda', misto: 'Misto' } %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todos os rebanhos cadastrados</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Rebanhos</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Rebanhos</h5>
                <a href="/rebanhos/criar" class="btn btn-primary btn-sm">
                    <i class="mdi mdi-plus mr-1"></i> Novo Rebanho
                </a>
            </div>
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>Propriedade</th>
                                <th>Finalidade</th>
                                <th>Data Formação</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (rebanhos.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Nenhum rebanho cadastrado.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < rebanhos.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= rebanhos[i].nome %></td>
                                    <td><%= rebanhos[i].propriedade ? rebanhos[i].propriedade.nome : '—' %></td>
                                    <td><%= finalidadeLabels[rebanhos[i].finalidade] || rebanhos[i].finalidade %></td>
                                    <td><%= rebanhos[i].dataFormacao ? rebanhos[i].dataFormacao.split('-').reverse().join('/') : '—' %></td>
                                    <td>
                                        <span class="badge badge-<%= rebanhos[i].ativo ? 'success' : 'secondary' %>">
                                            <%= rebanhos[i].ativo ? 'Ativo' : 'Inativo' %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/rebanhos/<%= rebanhos[i].id %>/editar" class="text-warning mr-2">
                                            <i class="mdi mdi-pencil"></i>
                                        </a>
                                        <a href="/rebanhos/<%= rebanhos[i].id %>/excluir" class="text-danger">
                                            <i class="mdi mdi-delete"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
