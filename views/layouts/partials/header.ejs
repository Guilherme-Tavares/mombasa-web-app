<div class="header">
    <div class="header-content">
        <nav class="navbar navbar-expand">
            <div class="collapse navbar-collapse justify-content-between">
                <div class="header-left">
                    <div class="search_bar dropdown">
                        <span class="search_icon p-3 c-pointer" data-toggle="dropdown">
                            <i class="mdi mdi-magnify"></i>
                        </span>
                        <div class="dropdown-menu p-0 m-0">
                            <form>
                                <input class="form-control" type="search" placeholder="Buscar" aria-label="Buscar">
                            </form>
                        </div>
                    </div>
                </div>

                <ul class="navbar-nav header-right">
                    <li class="nav-item dropdown header-profile">
                        <a class="nav-link" href="#" role="button" data-toggle="dropdown">
                            <i class="mdi mdi-account"></i>
                            <% if (locals.usuario) { %>
                                <span class="ml-2 d-none d-sm-inline"><%= usuario.nome %></span>
                            <% } %>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <% if (locals.usuario) { %>
                                <span class="dropdown-item-text small text-muted"><%= usuario.email %></span>
                                <div class="dropdown-divider"></div>
                            <% } %>
                            <form id="logout-form" action="/logout" method="POST" class="m-0">
                                <button type="button" class="dropdown-item" onclick="confirmarLogout()">
                                    <i class="mdi mdi-logout"></i>
                                    <span class="ml-2">Sair</span>
                                </button>
                            </form>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
</div>

<script>
    // Confirmação de logout via SweetAlert2 (carregado no layout mestre).
    function confirmarLogout() {
        Swal.fire({
            title: 'Deseja sair?',
            text: 'Você precisará entrar novamente para acessar o sistema.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sair',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#4A7C3F',
            cancelButtonColor: '#7A6F67',
            reverseButtons: true,
            focusCancel: true
        }).then(function (resultado) {
            if (resultado.isConfirmed) {
                document.getElementById('logout-form').submit();
            }
        });
    }
</script>
