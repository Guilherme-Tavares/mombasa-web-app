<% const lotacao = locals.lotacao || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; <%= lotacao.id ? 'Atualize o vínculo de lotação' : 'Registre um rebanho em uma divisão' %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/lotacoes">Lotações</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)"><%= titulo %></a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <form action="/lotacoes/<%= lotacao.id ? lotacao.id + '/editar' : 'criar' %>" method="POST">

                    <div class="form-group mb-3">
                        <label for="rebanhoId" class="form-label">Rebanho <span class="text-danger">*</span></label>
                        <select class="form-control" id="rebanhoId" name="rebanhoId" required>
                            <option value="">Selecione...</option>
                            <% for (const r of rebanhos) { %>
                                <option value="<%= r.id %>" <%= lotacao.rebanho && lotacao.rebanho.id === r.id ? 'selected' : '' %>><%= r.nome %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="divisaoId" class="form-label">Divisão <span class="text-danger">*</span></label>
                        <select class="form-control" id="divisaoId" name="divisaoId" required>
                            <option value="">Selecione...</option>
                            <% for (const d of divisoes) { %>
                                <option value="<%= d.id %>" <%= lotacao.divisao && lotacao.divisao.id === d.id ? 'selected' : '' %>><%= d.nome %><%= d.propriedade ? ' (' + d.propriedade.nome + ')' : '' %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4 mb-3">
                            <label for="numeroCabecas" class="form-label">N° de Cabeças <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="numeroCabecas" name="numeroCabecas"
                                placeholder="0" min="1" step="1"
                                value="<%= lotacao.numeroCabecas != null ? lotacao.numeroCabecas : '' %>" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-5 mb-3">
                            <label for="dataEntrada" class="form-label">Data de Entrada <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="dataEntrada" name="dataEntrada"
                                value="<%= lotacao.dataEntrada || locals.hoje || '' %>" required>
                        </div>

                        <div class="form-group col-md-5 mb-3">
                            <label for="dataSaida" class="form-label">Data de Saída</label>
                            <input type="date" class="form-control" id="dataSaida" name="dataSaida"
                                value="<%= lotacao.dataSaida || '' %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">
                            <%= lotacao.id ? 'Salvar Alterações' : 'Registrar Lotação' %>
                        </button>
                        <a href="/lotacoes" class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
