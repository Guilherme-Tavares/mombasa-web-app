<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Vincule rebanhos a divisões de propriedades</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Lotações</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Lotações</h5>
                <a href="/lotacoes/criar" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus mr-1"></i> Nova Lotação
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Rebanho</th>
                                <th>Divisão</th>
                                <th>Propriedade</th>
                                <th>Cabeças</th>
                                <th>Entrada</th>
                                <th>Saída</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (lotacoes.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center text-muted">Nenhuma lotação cadastrada.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < lotacoes.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= lotacoes[i].rebanho ? lotacoes[i].rebanho.nome : '—' %></td>
                                    <td><%= lotacoes[i].divisao ? lotacoes[i].divisao.nome : '—' %></td>
                                    <td><%= lotacoes[i].divisao && lotacoes[i].divisao.propriedade ? lotacoes[i].divisao.propriedade.nome : '—' %></td>
                                    <td><%= lotacoes[i].numeroCabecas %></td>
                                    <td><%= lotacoes[i].dataEntrada ? lotacoes[i].dataEntrada.split('-').reverse().join('/') : '—' %></td>
                                    <td><%= lotacoes[i].dataSaida ? lotacoes[i].dataSaida.split('-').reverse().join('/') : '—' %></td>
                                    <td>
                                        <a href="/lotacoes/<%= lotacoes[i].id %>/editar" class="text-warning mr-2">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/lotacoes/<%= lotacoes[i].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
