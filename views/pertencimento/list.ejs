<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Vincule bovinos a rebanhos</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Pertencimentos</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Pertencimentos</h5>
                <a href="/pertencimentos/criar" class="btn btn-primary btn-sm">
                    <i class="fa fa-plus mr-1"></i> Novo Pertencimento
                </a>
            </div>
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Bovino</th>
                                <th>Brinco</th>
                                <th>Rebanho</th>
                                <th>Peso Entrada (kg)</th>
                                <th>Entrada</th>
                                <th>Saída</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (pertencimentos.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center text-muted">Nenhum pertencimento cadastrado.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < pertencimentos.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= pertencimentos[i].bovino ? pertencimentos[i].bovino.nome : '—' %></td>
                                    <td><%= pertencimentos[i].bovino && pertencimentos[i].bovino.brinco ? pertencimentos[i].bovino.brinco : '—' %></td>
                                    <td><%= pertencimentos[i].rebanho ? pertencimentos[i].rebanho.nome : '—' %></td>
                                    <td><%= pertencimentos[i].pesoEntradaKg != null ? parseFloat(pertencimentos[i].pesoEntradaKg).toFixed(2) : '—' %></td>
                                    <td><%= pertencimentos[i].dataEntrada ? pertencimentos[i].dataEntrada.split('-').reverse().join('/') : '—' %></td>
                                    <td><%= pertencimentos[i].dataSaida ? pertencimentos[i].dataSaida.split('-').reverse().join('/') : '—' %></td>
                                    <td>
                                        <a href="/pertencimentos/<%= pertencimentos[i].id %>/editar" class="text-warning mr-2">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/pertencimentos/<%= pertencimentos[i].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
