<% const tipoLabels = { pasto: 'Pasto', reserva: 'Reserva', instalacao: 'Instalação' } %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; Consulte todas as divisões cadastradas</p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)">Divisões</a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0" style="text-transform: none">Lista de Divisões</h5>
                <a href="/divisoes/criar" class="btn btn-primary btn-sm">
                    <i class="icon icon-layers-3 mr-1"></i> Nova Divisão
                </a>
            </div>
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <div class="table-responsive">
                    <table class="table table-responsive-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>Propriedade</th>
                                <th>Tipo</th>
                                <th>Área (ha)</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (divisoes.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Nenhuma divisão cadastrada.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < divisoes.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= divisoes[i].nome %></td>
                                    <td><%= divisoes[i].propriedade ? divisoes[i].propriedade.nome : '—' %></td>
                                    <td><%= tipoLabels[divisoes[i].tipo] || divisoes[i].tipo %></td>
                                    <td><%= divisoes[i].areaHectares != null ? divisoes[i].areaHectares : '—' %></td>
                                    <td>
                                        <span class="badge badge-<%= divisoes[i].ativa ? 'success' : 'secondary' %>">
                                            <%= divisoes[i].ativa ? 'Ativa' : 'Inativa' %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/divisoes/<%= divisoes[i].id %>/editar" class="text-warning mr-2">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </a>
                                        <a href="/divisoes/<%= divisoes[i].id %>/excluir" class="text-danger">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
