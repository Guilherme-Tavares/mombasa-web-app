<% const divisao = locals.divisao || {} %>

<div class="row page-titles mx-0">
    <div class="col-sm-6 p-md-0">
        <div class="welcome-text">
            <h4 style="text-transform: none"><%= titulo %></h4>
            <p class="mb-0">&raquo; <%= divisao.id ? 'Atualize os dados da divisão' : 'Preencha os dados da nova divisão' %></p>
        </div>
    </div>
    <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Início</a></li>
            <li class="breadcrumb-item"><a href="/divisoes">Divisões</a></li>
            <li class="breadcrumb-item active"><a href="javascript:void(0)"><%= titulo %></a></li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <%- include('../layouts/partials/alert-erro') %>

                <form action="/divisoes/<%= divisao.id ? divisao.id + '/editar' : 'criar' %>" method="POST">

                    <div class="form-group mb-3">
                        <label for="propriedadeId" class="form-label">Propriedade <span class="text-danger">*</span></label>
                        <select class="form-control" id="propriedadeId" name="propriedadeId" required>
                            <option value="">Selecione...</option>
                            <% for (const p of propriedades) { %>
                                <option value="<%= p.id %>" <%= divisao.propriedade && divisao.propriedade.id === p.id ? 'selected' : '' %>><%= p.nome %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nome" name="nome"
                            placeholder="Ex.: Pasto 1, Curral, Reserva Norte"
                            value="<%= divisao.nome || '' %>" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-3">
                            <label for="tipo" class="form-label">Tipo <span class="text-danger">*</span></label>
                            <select class="form-control" id="tipo" name="tipo" required>
                                <option value="pasto" <%= !divisao.id || divisao.tipo === 'pasto' ? 'selected' : '' %>>Pasto</option>
                                <option value="reserva" <%= divisao.tipo === 'reserva' ? 'selected' : '' %>>Reserva</option>
                                <option value="instalacao" <%= divisao.tipo === 'instalacao' ? 'selected' : '' %>>Instalação</option>
                            </select>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label for="areaHectares" class="form-label">Área (ha)</label>
                            <input type="number" class="form-control" id="areaHectares" name="areaHectares"
                                placeholder="0.00" step="0.01" min="0"
                                value="<%= divisao.areaHectares != null ? divisao.areaHectares : '' %>">
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label for="ativa" class="form-label">Status</label>
                        <select class="form-control" id="ativa" name="ativa">
                            <option value="1" <%= !divisao.id || divisao.ativa ? 'selected' : '' %>>Ativa</option>
                            <option value="0" <%= divisao.id && !divisao.ativa ? 'selected' : '' %>>Inativa</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary mr-2">
                            <%= divisao.id ? 'Salvar Alterações' : 'Cadastrar Divisão' %>
                        </button>
                        <a href="/divisoes" class="btn btn-secondary">Cancelar</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
